# =============================================================================
# .env.example — Variáveis de Ambiente (MedRoute v2.0)
#
# INSTRUÇÃO CRÍTICA:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha com suas credenciais REAIS em .env
# 3. NUNCA faça commit de .env contendo credenciais verdadeiras
# 4. O arquivo .env está no .gitignore (seguro)
# =============================================================================

# ═══════════════════════════════════════════════════════════════════════════
# OpenAI LLM Configuration (Aba "LLM / Relatório" funciona mesmo sem isto)
# ═══════════════════════════════════════════════════════════════════════════

# Obtenha em: https://platform.openai.com/account/api-keys
# Nota: Deixe vazio ou comment para usar fallback de templates (sem IA)
OPENAI_API_KEY=sk-your-api-key-here

# Modelo OpenAI a usar para geração de relatórios
# Recomendado: gpt-4o-mini (rápido e barato)
OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════════════════
# Configurações da Aplicação
# ═══════════════════════════════════════════════════════════════════════════

# Modo debug (False para produção)
DEBUG=False

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════
# Parâmetros Padrão do Algoritmo Genético (Opcional)
# Nota: Podem ser sobrescritos pela interface Streamlit
# ═══════════════════════════════════════════════════════════════════════════

# Tamanho da população (50-300, padrão: 80)
GA_POPULATION_SIZE=80

# Taxa de mutação (0.01-0.20, padrão: 0.05)
GA_MUTATION_RATE=0.05

# Número de gerações (10-300, padrão: 100)
GA_GENERATIONS=100

# Tipo de seleção (tournament, roulette)
GA_SELECTION_TYPE=tournament

# ═══════════════════════════════════════════════════════════════════════════
# Dados de Teste (Opcional)
# ═══════════════════════════════════════════════════════════════════════════

# Usar mock_data para testes (True/False)
USE_MOCK_DATA=True

# Seed para reproduzibilidade (deixe vazio ou comentado para aleatório)
# RANDOM_SEED=42
