# =============================================================================
# .env — Variáveis de Ambiente Local (NÃO COMMITAR ESTE ARQUIVO!)
# 
# ARQUIVO SEGURO: Credenciais reais são confidenciais
# Este arquivo está em .gitignore (protegido)
# =============================================================================

# OpenAI API Key (DEIXE VAZIO para usar fallback de templates)
# Obtenha em: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Modelo a usar (rápido e econômico)
OPENAI_MODEL=gpt-4o-mini

# Configurações da Aplicação
DEBUG=False
LOG_LEVEL=INFO

# Configurações do GA
GA_POPULATION_SIZE=80
GA_MUTATION_RATE=0.05
GA_GENERATIONS=100
GA_SELECTION_TYPE=tournament

# Dados de Teste
USE_MOCK_DATA=True
